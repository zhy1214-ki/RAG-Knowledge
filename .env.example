# Copy to .env and replace local demonstration secrets.
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL local example; URL-encode password special characters:
# DATABASE_URL=postgresql+psycopg://rag:YOUR_PASSWORD@127.0.0.1:5432/rag_knowledge
JWT_SECRET=replace-with-a-long-random-value
# Compose password must be random alphanumeric to avoid URL escaping issues.
POSTGRES_PASSWORD=replace-with-random-alphanumeric-password
STORAGE_DIR=./data/uploads
VECTOR_URI=./data/milvus.db
VECTOR_BACKEND=milvus
MODEL_BACKEND=mock
ALLOW_PAID_MODELS=false
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
MAX_UPLOAD_BYTES=20971520
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
